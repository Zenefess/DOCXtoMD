# .gitignore -- everything an MSVC build or Visual Studio drops into the working tree.
#
# The project sets no OutDir, so both the binaries and the intermediates land under x64\, which is
# why one entry covers Debug and Release alike. Nothing here is generated by a Linux session; a
# remote session that cannot run msbuild will never produce any of it.

# Build output and intermediates: x64\Debug\, x64\Release\, and the .obj/.pdb/.ilk/.tlog files
# msbuild writes beside them. x64 is the only platform (GCS a2, decision D3), so there is no Win32
# tree to ignore.
/x64/

# The unit-test project sits in tests\, so MSBuild's default paths put its binaries and
# intermediates under tests\x64\ rather than in the root tree above.
/tests/x64/

# Visual Studio's per-solution state directory, which also holds the IntelliSense database.
/.vs/

# Per-user project settings. Visual Studio writes this on first open; it is never shared.
*.vcxproj.user

# Fixtures tests/make_fixtures.py generates. The reviewable part trees under tests/fixtures/ are
# committed; the .docx files zipped from them, and the synthesised hostile ones, are not.
/tests/build/

# CPython's bytecode cache, which appears the moment run_container.py imports make_fixtures.
__pycache__/
