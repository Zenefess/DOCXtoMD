    <w:p><w:pPr><w:pStyle w:val="NoSuchStyle"/></w:pPr><w:r><w:t>An unknown style is an ordinary paragraph.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="LoopA"/></w:pPr><w:r><w:t>A cycle in basedOn is not a heading and is not a hang.</w:t></w:r></w:p>
