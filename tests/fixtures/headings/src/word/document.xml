  <w:body>
    <w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>By name</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>By identifier</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Heading_20_4"/></w:pPr><w:r><w:t>An escaped space in the identifier</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Source_20_Text"/></w:pPr><w:r><w:t>A name that is not a heading stays a paragraph.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="MyHeading"/></w:pPr><w:r><w:t>Through basedOn</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Berschrift5"/></w:pPr><w:r><w:t>Named in English over a localized identifier</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Heading7"/></w:pPr><w:r><w:t>Clamped to six</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="TitleStyle"/></w:pPr><w:r><w:t>The title</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="SubtitleStyle"/></w:pPr><w:r><w:t>The subtitle</w:t></w:r></w:p>
